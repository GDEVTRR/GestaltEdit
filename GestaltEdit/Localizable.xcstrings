                    "After the Siri AI model download finishes, use this backup to remove device spoofing. Face ID and dictation will work again after restarting, while Siri AI settings stay enabled.":  {
                                                                                                                                                                                                               "extractionState":  "manual",
                                                                                                                                                                                                               "localizations":  {
                                                                                                                                                                                                                                     "en":  {
                                                                                                                                                                                                                                                "stringUnit":  {
                                                                                                                                                                                                                                                                   "state":  "translated",
                                                                                                                                                                                                                                                                   "value":  "After the Siri AI model download finishes, use this backup to remove device spoofing. Face ID and dictation will work again after restarting, while Siri AI settings stay enabled."
                                                                                                                                                                                                                                                               }
                                                                                                                                                                                                                                            },
                                                                                                                                                                                                                                     "tr":  {
                                                                                                                                                                                                                                                "stringUnit":  {
                                                                                                                                                                                                                                                                   "state":  "translated",
                                                                                                                                                                                                                                                                   "value":  "Siri Yapay Zekâ modeli indirildikten sonra cihaz kimliği taklidini kaldırmak için bu yedeği kullan. Yeniden başlatmanın ardından Face ID ve dikte yeniden çalışır; Siri Yapay Zekâ ayarları etkin kalır."
                                                                                                                                                                                                                                                               }
                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                 }
                                                                                                                                                                                                           },
