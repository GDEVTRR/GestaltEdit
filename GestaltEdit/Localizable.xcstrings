                                                                                                                                                    "tr":  {
                                                                                                                                                               "stringUnit":  {
                                                                                                                                                                                  "state":  "translated",
                                                                                                                                                                                  "value":  "Önce mevcut dosya yedeklenir. Geri yüklemeden sonra SpringBoard otomatik olarak yenilenir."
                                                                                                                                                                              }
                                                                                                                                                           }
                                                                                                                                                }
                                                                                                                          },
