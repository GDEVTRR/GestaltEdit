                               },
                    "Complete the Siri AI model download first. Your original device identity will be restored, and Face ID and dictation will work again after restarting. SiriMode and other AI settings stay enabled. The current file will be backed up before writing.":  {
                                                                                                                                                                                                                                                                                   "extractionState":  "manual",
                                                                                                                                                                                                                                                                                   "localizations":  {
                                                                                                                                                                                                                                                                                                         "en":  {
                                                                                                                                                                                                                                                                                                                    "stringUnit":  {
                                                                                                                                                                                                                                                                                                                                       "state":  "translated",
                                                                                                                                                                                                                                                                                                                                       "value":  "Complete the Siri AI model download first. Your original device identity will be restored, and Face ID and dictation will work again after restarting. SiriMode and other AI settings stay enabled. The current file will be backed up before writing."
                                                                                                                                                                                                                                                                                                                                   }
                                                                                                                                                                                                                                                                                                                },
                                                                                                                                                                                                                                                                                                         "tr":  {
                                                                                                                                                                                                                                                                                                                    "stringUnit":  {
                                                                                                                                                                                                                                                                                                                                       "state":  "translated",
                                                                                                                                                                                                                                                                                                                                       "value":  "Önce Siri Yapay Zekâ modeli indirmesini tamamla. Özgün cihaz kimliğin geri yüklenir; yeniden başlatmanın ardından Face ID ve dikte yeniden çalışır. SiriMode ve diğer yapay zekâ ayarları etkin kalır. Yazma işleminden önce mevcut dosya yedeklenir."
                                                                                                                                                                                                                                                                                                                                   }
                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                     }
                                                                                                                                                                                                                                                                               },
                    "The current Apple Watch file will be backed up first. The watch interface will restart automatically after restoring.":  {
                                                                                                                                                  "extractionState":  "manual",
                                                                                                                                                  "localizations":  {
                                                                                                                                                                        "en":  {
                                                                                                                                                                                   "stringUnit":  {
                                                                                                                                                                                                      "state":  "translated",
                                                                                                                                                                                                      "value":  "The current Apple Watch file will be backed up first. The watch interface will restart automatically after restoring."
                                                                                                                                                                                                  }
                                                                                                                                                                               },
                                                                                                                                                                        "tr":  {
                                                                                                                                                                                   "stringUnit":  {
                                                                                                                                                                                                      "state":  "translated",
                                                                                                                                                                                                      "value":  "Önce mevcut Apple Watch dosyası yedeklenir. Geri yüklemeden sonra saat arayüzü otomatik olarak yeniden başlatılır."
                                                                                                                                                                                                  }
                                                                                                                                                                               }
                                                                                                                                                                    }
                                                                                                                                              },
                    "The current file will be backed up first. SpringBoard will refresh automatically after restoring.":  {
                                                                                                                              "extractionState":  "manual",
                                                                                                                              "localizations":  {
                                                                                                                                                    "en":  {
                                                                                                                                                               "stringUnit":  {
                                                                                                                                                                                  "state":  "translated",
