                                                                                                                                                                                 }
                                                                                                                                                              },
                                                                                                                                                       "tr":  {
                                                                                                                                                                  "stringUnit":  {
                                                                                                                                                                                     "state":  "translated",
                                                                                                                                                                                     "value":  "Cihaz üzerindeki MobileGestalt düzenlemesi için iOS / iPadOS 27 veya üzeri gerekir. iOS / iPadOS 26 desteklenmez."
                                                                                                                                                                                 }
                                                                                                                                                              }
                                                                                                                                                   }
